{
  "name": "opencode-control-plane",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "A high-efficiency, zero-token orchestrator that turns OpenCode into a policy-bounded, self-verifying coding worker.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therealedo/opencode-control-plane.git"
  },
  "homepage": "https://github.com/therealedo/opencode-control-plane#readme",
  "bugs": {
    "url": "https://github.com/therealedo/opencode-control-plane/issues"
  },
  "scripts": {
    "setup": "node scripts/install-project.mjs",
    "launcher:install": "node scripts/install-launcher.mjs",
    "launcher:dry-run": "node scripts/install-launcher.mjs --dry-run",
    "launcher:remove": "node scripts/install-launcher.mjs --remove",
    "project:install": "node scripts/install-project.mjs",
    "uninstall:global": "node scripts/uninstall-global.mjs",
    "legacy:global-install": "node scripts/install.mjs",
    "legacy:global-upgrade": "node scripts/upgrade.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "validate": "node scripts/validate-source.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm test",
    "install:dry-run": "node scripts/install.mjs --dry-run"
  },
  "engines": {
    "node": ">=20"
  }
}
